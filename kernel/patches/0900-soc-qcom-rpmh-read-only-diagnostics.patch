+#if IS_ENABLED(CONFIG_QCOM_RPMH_SUCCESS_DEBUG)
+static void rpmh_rsc_snapshot_tcs(struct rsc_drv *drv, const char *phase,
+					  const char *group, int tcs_id)
+{
+	unsigned long cmd_enable;
+	u32 irq_status, tcs_status, control;
+	bool command_seen = false;
+	int cmd_id;
+
+	irq_status = readl_relaxed(drv->tcs_base +
+					   drv->regs[RSC_DRV_IRQ_STATUS]);
+	tcs_status = read_tcs_reg(drv, drv->regs[RSC_DRV_STATUS], tcs_id);
+	control = read_tcs_reg(drv, drv->regs[RSC_DRV_CONTROL], tcs_id);
+	cmd_enable = read_tcs_reg(drv, drv->regs[RSC_DRV_CMD_ENABLE], tcs_id);
+
+	for_each_set_bit(cmd_id, &cmd_enable, MAX_CMDS_PER_TCS) {
+		char resource[CMD_DB_ID_SIZE + 1] = "unknown";
+		u32 msgid, addr, data, cmd_status, resp_data;
+		struct rpmh_rsc_snapshot_data snapshot;
+
+		msgid = read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_MSGID],
+					     tcs_id, cmd_id);
+		addr = read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_ADDR],
+					    tcs_id, cmd_id);
+		data = read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_DATA],
+					    tcs_id, cmd_id);
+		cmd_status = read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_STATUS],
+						   tcs_id, cmd_id);
+		resp_data = read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_RESP_DATA],
+						  tcs_id, cmd_id);
+		if (cmd_db_read_name(addr, resource, sizeof(resource)))
+			strscpy(resource, "unknown", sizeof(resource));
+
+		snapshot = (struct rpmh_rsc_snapshot_data) {
+			.tcs_id = tcs_id,
+			.cmd_id = cmd_id,
+			.version_major = drv->ver.major,
+			.version_minor = drv->ver.minor,
+			.tcs_in_use = test_bit(tcs_id, drv->tcs_in_use),
+			.irq_status = irq_status,
+			.tcs_status = tcs_status,
+			.control = control,
+			.cmd_enable = (u32)cmd_enable,
+			.command_enabled = true,
+			.msgid = msgid,
+			.addr = addr,
+			.data = data,
+			.cmd_status = cmd_status,
+			.resp_data = resp_data,
+			.resource = resource,
+		};
+		trace_rpmh_rsc_snapshot(drv, phase, group, &snapshot);
+		command_seen = true;
+	}
+
+	if (!command_seen) {
+		struct rpmh_rsc_snapshot_data snapshot = {
+			.tcs_id = tcs_id,
+			.cmd_id = -1,
+			.version_major = drv->ver.major,
+			.version_minor = drv->ver.minor,
+			.tcs_in_use = test_bit(tcs_id, drv->tcs_in_use),
+			.irq_status = irq_status,
+			.tcs_status = tcs_status,
+			.control = control,
+			.cmd_enable = (u32)cmd_enable,
+			.command_enabled = false,
+			.resource = "",
+		};
+
+		trace_rpmh_rsc_snapshot(drv, phase, group, &snapshot);
+	}
+}
+
+void rpmh_rsc_success_snapshot(struct rsc_drv *drv, const char *phase)
+{
+	static const int types[] = { ACTIVE_TCS, SLEEP_TCS, WAKE_TCS };
+	static const char * const groups[] = { "active", "sleep", "wake" };
+	int i, tcs_id;
+
+	for (i = 0; i < ARRAY_SIZE(types); i++) {
+		const struct tcs_group *tcs = &drv->tcs[types[i]];
+
+		for (tcs_id = tcs->offset;
+		     tcs_id < tcs->offset + tcs->num_tcs; tcs_id++)
+			rpmh_rsc_snapshot_tcs(drv, phase, groups[i], tcs_id);
+	}
+}
+#else
+void rpmh_rsc_success_snapshot(struct rsc_drv *drv, const char *phase)
+{
+	(void)drv;
+	(void)phase;
+}
+#endif
